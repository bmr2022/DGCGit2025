        function calculateFooterTotalsSafe() {

            const excludedFields = [
                "HSNNO", "PartCode", "Canceldate", "CancelReason",
                "Ewaybillno", "EinvGenerated", "EInvNo",
                "salebillentryId", "LastUpdatedByEmp",
                "GSTNO", "ConsigneeName", "ConsigneeAddress",
                "forTheDuration", "ForFinYear", "Remark",
                "SalesPersonName", "BankName", "Cancelreason",
                "Commodity", "DispatchDelayReason",
                "DispatchThrough", "DistanceKM",
                "ItemRemark", "CostCenterName",
                "CancelReason1", "Salebillentryid",
                "PartyPartCode", "GRNNO",
                "CustPartCode", "TransporterName",
                "ModOfTransport", "CGSTPer", "SGSTPer", "IGSTPer", "StateCode", "salebillYearCode", "RevNo", "HSeqNo",
                "SeqNo", "ItemCode", "AccountCode", "SeqNo1", "GST NO", "STATE", "Place of Supply", "ITEM NAME", "ITEM DISCRIPTION",
                "HSNCODE"
            ];

            let totals = {};

            // clear footer first
            $('#ReportTable tfoot td').text('');

            $('#ReportTable tbody tr').each(function() {

                $(this).find('td[data-field]').each(function() {

                    let field = $(this).data('field');

                    if (!field)
                        return;

                    // skip excluded fields
                    if (excludedFields.includes(field))
                        return;

                    let text = $(this).text().trim();

                    // remove commas and currency symbols
                    text = text
                        .replace(/,/g, '')
                        .replace(/₹/g, '')
                        .trim();

                    // skip blank
                    if (text === '')
                        return;

                    // allow only pure numeric values
                    if (!/^-?\d+(\.\d+)?$/.test(text))
                        return;

                    let value = parseFloat(text);

                    if (isNaN(value))
                        return;

                    if (!totals[field]) {
                        totals[field] = 0;
                    }

                    totals[field] += value;

                });

            });

            // set totals in footer
            for (let field in totals) {

                let safeField = field.replace(/[^a-zA-Z0-9]/g, '_');

                $('#tfoot_' + safeField).text(
                    totals[field].toFixed(2)
                );
            }
        }

        $('#sendToPDF').click(async function() {
            var fromDate = $('#FromDate').val();
            var toDate = $('#ToDate').val();

            if ($('#ReportType').val() == 'Customer Wise Total Qty+Amount') {

                window.open(
                    '/SaleBillRegister/ExportCustomerWisePDF?FromDate=' + fromDate + '&ToDate=' + toDate,
                    '_blank'
                );
            }
            else {

                const resp = await fetch(`/SaleBillRegister/GetSaleBillRegistergridData`);

                if (!resp.ok) {

                    alert("Failed to fetch data");

                    return;
                }

                const rows = await resp.json();

                if (!rows || rows.length === 0) {

                    alert("No Data Found");

                    return;
                }

                const excludedColumns = [
                    "entryId",
                    "yearCode"
                ];

                const headers = Object.keys(rows[0])
                    .filter(x => !excludedColumns.includes(x));

                let pdfFormat = 'a4';

                if (headers.length > 15) {

                    pdfFormat = 'a2';
                }
                else if (headers.length > 8) {

                    pdfFormat = 'a3';
                }

                const { jsPDF } = window.jspdf;

                const doc = new jsPDF({

                    orientation: 'landscape',

                    unit: 'pt',

                    format: pdfFormat
                });

                var reportType = $('#ReportType').val();

                var reportTitle = $('#ReportType option:selected').text();

                doc.setFontSize(18);

                doc.text(reportTitle, 40, 40);
                doc.setFontSize(10);
                doc.text(`From : ${fromDate} To: ${toDate}`, 40, 58);

                const formattedHeaders = headers.map(h =>
                    h.replace(/([A-Z])/g, ' $1')
                        .replace(/^./, str => str.toUpperCase())
                );

                const body = rows.map(r => {

                    return headers.map(h => {

                        let value = r[h];

                        // Null Check
                        if (value === null || value === undefined)
                            return '';

                        // Proper Date Format
                        if (typeof value === 'string' && value.includes('T')) {

                            let date = new Date(value);

                            if (!isNaN(date)) {

                                return date.toLocaleDateString('en-GB');
                            }
                        }

                        return value;

                    });

                });

                doc.autoTable({

                    startY: 80,

                    head: [formattedHeaders],

                    body: body,

                    theme: 'grid',

                    styles: {

                        fontSize: headers.length > 20 ? 4.5 : 8,

                        cellPadding: 3,

                        overflow: 'linebreak',

                        halign: 'center',

                        valign: 'middle'
                    },

                    headStyles: {

                        fillColor: [41, 128, 185],

                        textColor: 255,

                        fontStyle: 'bold',

                        fontSize: headers.length > 20 ? 5 : 9
                    },

                    margin: {

                        left: 20,

                        right: 20
                    },

                    tableWidth: 'wrap',

                    showHead: 'everyPage',

                    pageBreak: 'auto',

                    didParseCell: function(data) {

                        const pageWidth = doc.internal.pageSize.getWidth();

                        const columnCount = headers.length;

                        const availableWidth = pageWidth - 40;

                        data.cell.styles.cellWidth = availableWidth / columnCount;
                    }
                });

                doc.save(`${reportType}.pdf`);
            }
        });

        function FillSaleBillList() {
            var FromDate = $('#FromDate').val();
            var FromParts = FromDate.split("/");
            var formattedFromDate = `${FromParts[2]}-${FromParts[1]}-${FromParts[0]}`;
            var ToDate = $('#ToDate').val();
            var ToParts = ToDate.split("/");
            var formattedToDate = `${ToParts[2]}-${ToParts[1]}-${ToParts[0]}`;
            $.ajax({
                type: "POST",
                url: "@Url.Action("FillSaleBillList")",
                dataType: "JSON",
                async: false,
                data: { "FromDate": formattedFromDate, "ToDate": formattedToDate },
                success: function(result, status, error) {
                    if (result != null) {
                        var obj = $.parseJSON(result);
                        if (obj.StatusCode == 200 && obj.StatusText == 'Success') {
                            $('#SaleBillNo').empty();
                            $('#SaleBillNo').append('<option value="0" selected>-Select-</option>');
                            $.each(obj.Result, function(index, val) {
                                $('#SaleBillNo').append('<option value="' + val.SaleBillNo +
