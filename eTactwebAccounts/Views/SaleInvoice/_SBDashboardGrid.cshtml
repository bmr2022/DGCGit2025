@model eTactWeb.DOM.Models.SaleBillDashboard
@using Microsoft.AspNetCore.Http
@using System.Reflection.PortableExecutable
@using eTactWeb.Data.Common
@inject IHttpContextAccessor HttpContextAccessor
@inject EncryptDecrypt encryptDecrypt

@{
    
    var TotalNetAmt=ViewBag.TotalNetAmt;
    var yearCode = Convert.ToInt32(HttpContextAccessor.HttpContext.Session.GetString("YearCode"));    // var PoallowtoprintWithoutApproval = HttpContextAccessor.HttpContext.Session.GetString("PoallowtoprintWithoutApproval");
    // string PoallowtoprintWithoutApproval = HttpContextAccessor.HttpContext.Request.Query["PoallowtoprintWithoutApproval"];
}
@* @if (Model.DashboardType == "Detail")
{
    <partial name="_DashboardDetailGrid" />
}
else *@
@{
    <div class="table-responsive" style="max-height:400px;">
        <table class="table table-bordered TbCss text-nowrap mb-0" id="PODashboardGrid">

            <thead class="bg-gradient card-headerBG text-light" id="dashPOThead">
                <tr>
                    <th>Sr#</th>
                    <th>Action<input type="checkbox" id="selectAll" /></th>
                    @if (Model.Headers != null && Model.Headers.Any())
                    {
                        var colIndex = 1;
                        foreach (var col in Model.Headers)
                        {
                            if (col.Field == "SaleBillEntryId" ||
        col.Field == "SaleBillYearCode")
                            {
                                continue;
                            }
                            <th data-columnno="@colIndex" data-sortorder="asc" class="sortCol">
                                <span style="padding:5px;margin:5px" class="sort-icon"><i class="fa" aria-hidden="true"></i></span>
                                @col.Title
                            </th>
                            colIndex++;
                        }
                    }
                </tr>
            </thead>
            <tbody id="divDashboardGrid1">

                @if (Model.Rows == null || Model.Rows.Count == 0)
                {
                    <tr class="text-center">
                        <td colspan="@((Model.Headers?.Count ?? 0) + 2)" class="text-black-50">
                            <strong>NO DATA FOUND</strong>
                        </td>
                    </tr>
                }
                else
                {
                    int Cntr = 0;

                    foreach (var row in Model.Rows)
                    {
                        Cntr++;
                        <tr id="approvedRow-@Cntr">
                            <th>
                                @Cntr
                                <input type="hidden" id="DomesticExportNEPZ-@Cntr" value="@(row.ContainsKey("DomesticExportNEPZ") ? row["DomesticExportNEPZ"]?.ToString() : "")" />
                                <input type="hidden" id="CancelBill-@Cntr" value="@(row.ContainsKey("CancelBill") ? row["CancelBill"]?.ToString() : "")" />
                                <input type="hidden" id="SaleBillJobwork-@Cntr" value="@(row.ContainsKey("SaleBillJobwork") ? row["SaleBillJobwork"]?.ToString() : "")" />
                            </th>
                            <td style="text-align:center;white-space: nowrap;">
                                <div id="container">

                                    <div id="printData-@Cntr">
                                        <a href="javascript:void(0);"
                                           onclick="openPopup('@Url.Action("PrintReport", new { SaleBillNo = row.ContainsKey("SaleBillNo") ? row["SaleBillNo"] : "", YearCode = row.ContainsKey("SaleBillYearCode") ? row["SaleBillYearCode"] : "" })')"
                                           class="table-link link-dark">
                                            <span class="fa-stack">
                                                <i class="fa fa-square fa-stack-2x"></i>
                                                <i class="fa-solid fa-print fa-stack-1x fa-inverse"></i>
                                            </span>
                                        </a>
                                    </div>
                                    <a class="table-link link-success"
                                       target="_blank"
                                       asp-action="ExportToExcel"
                                       asp-route-saleBillno="@(row.ContainsKey("SaleBillNo") ? row["SaleBillNo"] : "")"
                                       title="Export to Excel">
                                        <span class="fa-stack">
                                            <i class="fa fa-square fa-stack-2x"></i>
                                            <i class="fa-solid fa-file-excel fa-stack-1x fa-inverse"></i>
                                        </span>
                                    </a>
                                    <div id="viewCursorDiv-@Cntr">
                                        <a class="table-link link-success"  asp-action="SaleBillOnCounter" asp-route-Mode="V" asp-route-ID="@(row.ContainsKey("SaleBillEntryId") ? (Convert.ToInt32(row["SaleBillEntryId"])) : "")" asp-route-YearCode="@(row.ContainsKey("SaleBillYearCode") ? (Convert.ToInt32(row["SaleBillYearCode"])) : "")" onclick="BackButtonData(event)">
                                            <span class="fa-stack">
                                                <i class="fa fa-square fa-stack-2x"></i>
                                                <i class="fa-solid fa-magnifying-glass fa-stack-1x fa-inverse"></i>
                                            </span>
                                        </a>
                                    </div>
                                    
                                        <div id="editCursorDiv-@Cntr">

                                            <a class="table-link link-primary btnEditData"  asp-action="SaleBillOnCounter" asp-route-Mode="U" asp-route-ID="@(row.ContainsKey("SaleBillEntryId") ? (Convert.ToInt32(row["SaleBillEntryId"])) : "")" asp-route-YearCode="@(row.ContainsKey("SaleBillYearCode") ? (Convert.ToInt32(row["SaleBillYearCode"])) : "")">

                                                <span class="fa-stack">
                                                    <i class="fa fa-square fa-stack-2x"></i>
                                                    <i class="fa fa-pencil fa-stack-1x fa-inverse"></i>
                                                </span>
                                            </a>
                                        </div>
                                    
                                    
                                </div>
                            </td>

                            


                            @if (Model.Headers != null && Model.Headers.Any())
                            {
                                foreach (var col in Model.Headers)
                                {
                                    if (col.Field == "SaleBillEntryId" ||
        col.Field == "SaleBillYearCode")
                                    {
                                        continue;
                                    }
                                    <td>
                                        @{
                                            if (row.ContainsKey(col.Field) && row[col.Field] != null)
                                            {
                                                var value = row[col.Field];

                                                if (value is decimal || value is double || value is float)
                                                {
                                                    @string.Format("{0:0.00}", value)
                                                }
                                                else
                                                {
                                                    @value
                                                }
                                            }
                                        }
                                    </td>
                                }
                            }
                        </tr>
                    }
                }
            </tbody>
            <tfoot class="bg-light fw-bold">
                <tr>

                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td>@TotalNetAmt</td>
                    <td></td>


                    

                </tr>
            </tfoot>


        </table>

    </div>
    int displayedRows = Model.PageNumber * Model.PageSize;
    if (displayedRows > Model.TotalRecords)
    {
        displayedRows = Model.TotalRecords;
    }
    @*     <center><strong>TOTAL ROWS: <span>@displayedRows</span></strong></center> *@

    <center>
        <strong>
            <span style="margin-right: 30px;">TOTAL ROWS  : <span>@displayedRows</span></span>
            <span>TOTAL RECORDS : <span>@Model.TotalRecords</span></span>
        </strong>
    </center>

}




@{
    int totalPages = (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize);
}
@if (Model.TotalRecords > 0)
{
    //int totalPages = (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize);

    <ul class="pagination d-flex align-items-center">

        @if (Model.PageNumber > 1)
        {
            <li class="page-item">
                <a class="page-link page-btn" data-page="@(Model.PageNumber - 1)" href="#">Previous</a>
            </li>
        }

        @if (Model.PageNumber > 3)
        {
            <li class="page-item">
                <a class="page-link page-btn" data-page="1" href="#">1</a>
            </li>
            <li class="page-item disabled"><a class="page-link">...</a></li>
        }

        @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.PageNumber + 2, totalPages); i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link page-btn" data-page="@i" href="#">@i</a>
            </li>
        }

        @if (Model.PageNumber < totalPages - 2)
        {
            <li class="page-item disabled"><a class="page-link">...</a></li>
            <li class="page-item">
                <a class="page-link page-btn" data-page="@totalPages" href="#">@totalPages</a>
            </li>
        }

        @if (Model.PageNumber < totalPages)
        {
            <li class="page-item">
                <a class="page-link page-btn" data-page="@(Model.PageNumber + 1)" href="#">Next</a>
            </li>
        }

    </ul>
}
