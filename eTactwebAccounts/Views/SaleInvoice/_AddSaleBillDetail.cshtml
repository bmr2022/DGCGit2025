@model eTactWeb.DOM.Models.SaleBillModel

<input type="hidden" asp-for="ItemNetAmount" class="form-control" />
@for (int i = 0; i < (Model?.saleBillDetails?.Count ?? 0); i++)
{
    <tr>
        <td>
            @(i + 1)
            @Html.HiddenFor(m => m.saleBillDetails[i].SeqNo)
        </td>

       <td>
    <div style="display:flex; flex-direction:column;">

        <input name="saleBillDetails[@i].PartCode"
               value="@Model.saleBillDetails[i].PartCode"
               class="partcode-input" />

        <div style="display:flex; align-items:center; gap:4px;">

            <input name="saleBillDetails[@i].ItemName"
                   value="@Model.saleBillDetails[i].ItemName" readonly
                   tabindex="-1"

                   class="itemname-input"
                   style="flex:1;" />

            <button type="button"
                    tabindex="-1"
                    class="other-detail-btn"
                    onclick="toggleOtherDetail(this)"
                    title="Other Detail"
                    style="width:24px;
                           height:24px;
                           padding:0;
                           border:1px solid #999;
                           background:#f5f5f5;
                           border-radius:3px;
                           cursor:pointer;">
                +
            </button>

        </div>

        <input name="saleBillDetails[@i].OtherDetail"
               value="@Model.saleBillDetails[i].OtherDetail"
               class="other-detail-input"
               placeholder="Other Detail"
               style="display:none; width:100%; margin-top:3px;" />

        <input name="saleBillDetails[@i].ItemCode"
               value="@Model.saleBillDetails[i].ItemCode"
               class="ItemCode-input"
               type="hidden" />

    </div>
</td>

     
       <td>
    <div style="display:flex; align-items:center; gap:4px;">

        <input name="saleBillDetails[@i].Qty"
               value="@Model.saleBillDetails[i].Qty"
               class="qty"
               onfocusout="calculateRow(this)" />

        <div style="display:flex; flex-direction:column;">
            <small style="font-size:10px; line-height:12px;">
                Total Stock
            </small>

            <input name="saleBillDetails[@i].TotalStock"
               value="@Model.saleBillDetails[i].TotalStock"
                   class="total-stock"
                   readonly
                   tabindex="-1"
                   style="width:80px;" />
        </div>

    </div>
</td>

        <td>
            <div style="display:flex; flex-direction:column;">
                <input name="saleBillDetails[@i].Unit" tabindex="-1"
                       value="@Model.saleBillDetails[i].Unit" class="Unit" readonly />
                <input name="saleBillDetails[@i].HSNNo" tabindex="-1"
                       value="@Model.saleBillDetails[i].HSNNo" class="HSNNo" readonly />
            </div>
        </td>

        <td>
            <div style="display:flex; flex-direction:column;">
                <input name="saleBillDetails[@i].Rate"
                       value="@Model.saleBillDetails[i].Rate"
                       class="rate"
                       onfocusout="calculateRow(this)" />

            </div>
        </td>

       
        <td>
            <div style="display:flex; flex-direction:column;">
                <input name="saleBillDetails[@i].DiscountPer"
                       value="@Model.saleBillDetails[i].DiscountPer"
                       class="discPer"
                       onfocusout="calculateRow(this)" />

                <input name="saleBillDetails[@i].DiscountAmt"
                       value="@Model.saleBillDetails[i].DiscountAmt"
                       class="discamt" tabindex="-1"
                       readonly />
            </div>
        </td>

        <td>
            <input name="saleBillDetails[@i].Amount"
                   value="@Model.saleBillDetails[i].Amount"
                   class="amount" tabindex="-1"
                   readonly />
        </td>

        <td>
            <div style="display:flex; flex-direction:column;">
                <input name="saleBillDetails[@i].Group_name"
                       value="@Model.saleBillDetails[i].Group_name"
                       class="GroupName" tabindex="-1"
                       readonly />
                <input name="saleBillDetails[@i].ItemLocation"
                       value="@Model.saleBillDetails[i].ItemLocation"
                        tabindex="-1" readonly
                       class="ItemLocation" />
            </div>
        </td>

        

        <td>
            <div style="display:flex; flex-direction:column;">
                <input name="saleBillDetails[@i].IGSTPer"
                       value="@Model.saleBillDetails[i].IGSTPer"
                       class="igstp" readonly tabindex="-1"
                       oninput="calculateRow(this)" />

                <input name="saleBillDetails[@i].IGSTAmt"
                       value="@Model.saleBillDetails[i].IGSTAmt"
                       class="igsta"
                       readonly />
            </div>
        </td>


        <td>
            <div style="display:flex; flex-direction:column;">
                <input name="saleBillDetails[@i].CGSTPer"
                       value="@Model.saleBillDetails[i].CGSTPer"
                       class="cgstp" tabindex="-1"
                       oninput="calculateRow(this)"
                       readonly />

                <input name="saleBillDetails[@i].CGSTAmt"
                       value="@Model.saleBillDetails[i].CGSTAmt"
                       class="cgsta" tabindex="-1"
                       readonly />
            </div>
        </td>

        <td>
            <div style="display:flex; flex-direction:column;">
                <input name="saleBillDetails[@i].SGSTPer"
                       value="@Model.saleBillDetails[i].SGSTPer"
                       class="sgstp" tabindex="-1"
                       oninput="calculateRow(this)"
                       readonly />

                <input name="saleBillDetails[@i].SGSTAmt"
                       value="@Model.saleBillDetails[i].SGSTAmt"
                       class="sgsta"
                       readonly tabindex="-1" />
            </div>
        </td>

        <td>
            <button type="button" tabindex="-1"
                    onclick="deleteRow(this)">
                X
            </button>
        </td>
    </tr>
}