@model eTactWeb.DOM.Models.PBDashBoard

<div class="row">
    <div class="col-xxl-2 col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
        <div class="row">
            <div class="col">
                <label class="form-label">From Date</label>
                <input asp-for="FromDate" id="FromDate" maxlength="10" class="form-control"  />
            </div>
            <div class="col">
                <label class="form-label">To Date</label>
                <input asp-for="ToDate" id="ToDate" maxlength="10" class="form-control"  />
            </div>
            <input asp-for="FromDate1" type="hidden" />
            <input asp-for="ToDate1" type="hidden" />
            <input type="hidden" asp-for="formKey" value="@ViewBag.formKey" />
            <input type="hidden" asp-for="uniqueKey" value="@ViewBag.uniqueKey" />
        </div>
    </div>
    <div class="col-xxl-2 col-xl-2 col-lg-2 col-md-3 col-sm-6 col-xs-12">
        <label asp-for="DashboardType" class="form-label">Dashboard Type</label>
        <select class="form-select" asp-for="DashboardType">
            <option value="" disabled>-Select-</option>
            <option value="Summary" selected>Summary</option>
            <option value="Detail">Detail</option>
            <option value="TAXDetail">TAXDetail</option>
        </select>
    </div>
    <div class="col-xxl-1 col-xl-2 col-lg-2 col-md-3 col-sm-6 col-xs-12">
        <label asp-for="MRNType" class="form-label">MRN Type</label>
        <select class="form-select" asp-for="MRNType">
            <option value="MRN">MRN</option>
            <option value="JWMRN">JW MRN</option>
            <option value="ServiceGateEntry">Service Gate Entry</option>
            <option value="ALL">ALL</option>
        </select>
    </div>
<div class="col-xxl-2 col-xl-2 col-lg-2 col-md-3 col-sm-6 col-xs-12">
    <label asp-for="DocumentName" class="form-label">
        Document Name
    </label>

    <input asp-for="DocumentName"
           id="DocumentName"
           type="text"
           class="form-control dashboard-autocomplete"
           autocomplete="off"
           placeholder="Search Document Name" />
</div>
   <div class="col-md-3">
    <label asp-for="VendorName" class="form-label">Vendor Name</label>
    <input asp-for="VendorName"
           id="VendorName"
           type="text"
           class="form-control dashboard-autocomplete"
           autocomplete="off"
           placeholder="Search Vendor Name" />
</div>

<div class="col-xxl-2 col-xl-2 col-lg-2 col-md-3 col-sm-6 col-xs-12">
    <label asp-for="VoucherNo" class="form-label">Voucher No</label>
    <input asp-for="VoucherNo"
           id="VoucherNo"
           type="text"
           class="form-control dashboard-autocomplete"
           autocomplete="off"
           placeholder="Search Voucher No" />
</div>

<div class="col-xxl-2 col-xl-2 col-lg-2 col-md-3 col-sm-6 col-xs-12">
    <label asp-for="InvoiceNo" class="form-label">Invoice No</label>
    <input asp-for="InvoiceNo"
           id="InvoiceNo"
           type="text"
           class="form-control dashboard-autocomplete"
           autocomplete="off"
           placeholder="Search Invoice No" />
</div>

<div class="col-xxl-2 col-xl-2 col-lg-2 col-md-3 col-sm-6 col-xs-12">
    <label asp-for="MRNNo" class="form-label">MRN No</label>
    <input asp-for="MRNNo"
           id="MRNNo"
           type="text"
           class="form-control dashboard-autocomplete"
           autocomplete="off"
           placeholder="Search MRN No" />
</div>

<div class="col-xxl-2 col-xl-2 col-lg-2 col-md-3 col-sm-6 col-xs-12">
    <label asp-for="GateNo" class="form-label">Gate No</label>
    <input asp-for="GateNo"
           id="GateNo"
           type="text"
           class="form-control dashboard-autocomplete"
           autocomplete="off"
           placeholder="Search Gate No" />
</div>

<div class="col-xxl-2 col-xl-2 col-lg-2 col-md-3 col-sm-6 col-xs-12">
    <label asp-for="PartCode" class="form-label">Part Code</label>
    <input asp-for="PartCode"
           id="PartCode"
           type="text"
           class="form-control dashboard-autocomplete"
           autocomplete="off"
           placeholder="Search Part Code" />
</div>

<div class="col-md-3">
    <label asp-for="ItemName" class="form-label">Item Name</label>
    <input asp-for="ItemName"
           id="ItemName"
           type="text"
           class="form-control dashboard-autocomplete"
           autocomplete="off"
           placeholder="Search Item Name" />
</div>

<div class="col-xxl-2 col-xl-2 col-lg-2 col-md-3 col-sm-6 col-xs-12">
    <label asp-for="HSNNO" class="form-label">HSN No</label>
    <input asp-for="HSNNO"
           id="HSNNO"
           type="text"
           class="form-control dashboard-autocomplete"
           autocomplete="off"
           placeholder="Search HSN No" />
</div>
    <div class="col-sm-3 col-md-6 col-lg-4 col-xl-2">
        <label class="form-label">Global search</label>
        <input type="text" class="form-control" id="search-box" style="background-color:#FFFACD" placeholder="Search...">
    </div>
    <div class="col-sm-3 col-md-6 col-lg-4 col-xl-8 d-flex justify-content-center mt-3" width="inherit">
        <button class="btn btn-sm btn-outline-info" style="padding:3px;height:30px;width:100px;margin-left:20px;" type="button" onclick="GetSearchData();">
            <i class="fa-solid fa-magnifying-glass fa-fw fa-lg "></i>SEARCH
        </button>
        <button class="btn btn-sm btn-outline-success" style="padding:3px;height:30px;width:100px;margin-left:20px;" type="button" id="sendToExcel">
            <i class="fa-solid fa-upload fa-fw fa-lg "></i>EXCEL
        </button>
        <a class="btn btn-sm btn-outline-danger" style="padding:3px;height:30px;width:100px;margin-left:20px;" asp-controller="PurchaseBill" asp-action="DashBoard">
            <i class="fa-solid fa-rotate fa-fw fa-lg"></i>RESET
        </a>
        <div class="d-flex" style="margin-left:50px;margin-top:10px;">
            <label class="color-box" style="background-color: #FF0000;"></label><label style="margin-left:5px;margin-top:-5px;">UNAPPROVED</label>
            <label class="color-box" style="background-color: green;margin-left:25px;"></label><label style="margin-left:5px;margin-top:-5px;">APPROVED</label>
            <label class="color-box" style="background-color: #0dcaf0;margin-left:25px;"></label><label style="margin-left:5px;margin-top:-5px;">
                PAYMENT DONE
        </div>
    </div> 
</div>

<style>
    .color-box {
        width: 10px;
        height: 10px;
    }
</style>