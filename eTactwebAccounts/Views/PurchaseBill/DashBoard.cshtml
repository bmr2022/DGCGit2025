        function CheckApprovedOrNot() {

            var columnLength = $('#divDashboardGrid tr td').length;
            var rowLength = $('#divDashboardGrid tr').length;
            if (columnLength > 1) {
                for (var i = 1; i < rowLength; i++) {
                    var mainApproval = $('#approvedOrNot-' + i).val();
                    var firstLevelApproval = $('#fLevelApproved-' + i).val();
                    var ammApproval = $('#AmmApproved-' + i).val();
                    if ((ammApproval == "N" || ammApproval == null || ammApproval == "null" || ammApproval == "") && mainApproval == "Y") {
                        $('#approvedRow-' + i).css("color", "blue");
                    }
                    else if (mainApproval == "Y") {
                        $('#approvedRow-' + i).css("color", "green");
                    } else {
                        if (ammApproval == "Y")
                            $('#approvedRow-' + i).css("color", "blue");
                        else if (firstLevelApproval == "Y")
                            $('#approvedRow-' + i).css("color", "purple");
                        else
                            $('#approvedRow-' + i).css("color", "red");
                    }
                }
            }
        }

