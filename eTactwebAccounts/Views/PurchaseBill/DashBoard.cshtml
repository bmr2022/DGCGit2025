    // =========================================================
    // COMMON RESPONSE HANDLER
    // =========================================================
    function getAutocompleteRows(result) {

        let data = result;

        // API string return kare to JSON parse karo
        if (typeof data === "string") {
            try {
                data = JSON.parse(data);
            }
            catch (e) {
                console.error("Autocomplete JSON Parse Error:", e);
                return [];
            }
        }

        console.log("Autocomplete API Response:", data);

        // -----------------------------------------------------
        // 1. Direct Array
        // -----------------------------------------------------
        if (Array.isArray(data)) {
            return data;
        }

        // -----------------------------------------------------
        // 2. Result.Table
        // -----------------------------------------------------
        if (
            data &&
            data.Result &&
            Array.isArray(data.Result.Table)
        ) {
            return data.Result.Table;
        }

        // -----------------------------------------------------
        // 3. Result.table
        // -----------------------------------------------------
        if (
            data &&
            data.Result &&
            Array.isArray(data.Result.table)
        ) {
            return data.Result.table;
        }

        // -----------------------------------------------------
        // 4. Table
        // -----------------------------------------------------
        if (
            data &&
            Array.isArray(data.Table)
        ) {
            return data.Table;
        }

        // -----------------------------------------------------
        // 5. table
        // -----------------------------------------------------
        if (
            data &&
            Array.isArray(data.table)
        ) {
            return data.table;
        }

        // -----------------------------------------------------
        // 6. Result direct Array
        // -----------------------------------------------------
        if (
            data &&
            Array.isArray(data.Result)
        ) {
            return data.Result;
        }

        console.error(
            "Autocomplete rows not found in response:",
            data
        );

        return [];
    }


    // =========================================================
    // COMMON VALUE GETTER
    // =========================================================
    function getItemValue(item, possibleNames) {

        if (!item) {
            return "";
        }

        for (let i = 0; i < possibleNames.length; i++) {

            let key = possibleNames[i];

            if (
                item[key] !== undefined &&
                item[key] !== null &&
                item[key] !== ""
            ) {
                return item[key];
            }
        }

        return "";
    }


