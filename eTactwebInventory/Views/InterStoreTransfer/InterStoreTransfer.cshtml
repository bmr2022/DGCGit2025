        function OpenLotAllocationModal(ctrl) {

    let rowNo =
        $(ctrl).data('rowno');

    let itemCode =
        $('#ItemCode-' + rowNo).val();

    let partCode =
        $('#PartCode-' + rowNo).val();

    let itemName =
        $('#ItemName-' + rowNo).val();

    let totalStock = 0;

    // calculate total stock
    $('#tblbody tr').each(function () {

        let rowItemCode =
            $(this)
            .find('[id^="ItemCode-"]')
            .val();

        if (rowItemCode == itemCode) {

            totalStock += parseFloat(
                $(this)
                .find('[id^="BatchStock-"]')
                .val()
            ) || 0;
        }
    });

    // set values in modal
    $('#FocusedItemCode').val(itemCode);

    $('#ModalPartCode').val(partCode);

    $('#ModalItemName').val(itemName);

    $('#ModalTotalStock')
        .val(totalStock.toFixed(2));

    $('#RequiredQty').val('');

    $('#LotAllocationModal')
        .modal('show');

    setTimeout(function () {

        $('#RequiredQty').focus();

    }, 300);
}
function AllocateLots() {

    let itemCode =
        $('#FocusedItemCode').val();

    let requiredQty =
        parseFloat($('#RequiredQty').val()) || 0;

    let totalStock = 0;

    // calculate total stock of item
    $('#MultiItemBody tr').each(function () {

        let row = $(this);

        let rowItemCode =
            row.find('[id^="ItemCode-"]').val();

        if (rowItemCode == itemCode) {

            totalStock += parseFloat(
                row.find('[id^="BatchStock-"]').val()
            ) || 0;
        }
    });

    // validation
    if (requiredQty > totalStock) {

        alert(
            'Required Qty exceeds Total Stock.\n' +
            'Total Stock : ' +
            totalStock.toFixed(6)
        );

        return;
    }

    let remainingQty = requiredQty;

    // reset previous allocation
    $('#MultiItemBody tr').each(function () {

        let row = $(this);

        let rowItemCode =
            row.find('[id^="ItemCode-"]').val();

        if (rowItemCode == itemCode) {

            row.find('[id^="Qty-"]').val(0);

            row.find('.MBCheckbox')
                .prop('checked', false);
        }
    });

    // lot allocation
    $('#MultiItemBody tr').each(function () {

        let row = $(this);

        let rowItemCode =
            row.find('[id^="ItemCode-"]').val();

        if (rowItemCode == itemCode) {

            if (remainingQty <= 0)
                return false;

            let batchStock =
                parseFloat(
                    row.find('[id^="BatchStock-"]').val()
                ) || 0;

            let allocateQty =
                Math.min(remainingQty, batchStock);

            row.find('[id^="Qty-"]')
                .val(allocateQty.toFixed(6));

            row.find('.MBCheckbox')
                .prop('checked', allocateQty > 0);

            let rowNo =
                row.find('[id^="Qty-"]')
                   .attr('id')
                   .split('-')[1];

            // CalculateOnlyAmountForMalti(rowNo);

            remainingQty -= allocateQty;
        }
    });

    $('#LotAllocationModal').modal('hide');
}

         $('#CheckAll').on('click', function () {

            const isChecked = this.checked;   // single state
            const rows = $('#MultiItemBody tr');

            rows.each(function () {

                const $row = $(this);
                const $checkbox = $row.find('.mb-checkbox');

                // Set checkbox once
                $checkbox.prop('checked', isChecked);

                if (!isChecked) return;

                // Cache inputs
                const rate = parseFloat($row.find('.rate').val()) || 0;
                const qty = parseFloat($row.find('.qty').val()) || 0;

                const amount = rate * qty;

                $row.find('.amount').val(amount.toFixed(6));
            });
        });

