@model eTactWeb.DOM.Models.InterStoreTransferModel


@{
    var @Cntr = 0;
    if (Model.InterStoreDetails == null)
    {
        <tr class="text-center"><td colspan="26" class="text-black-50"><strong>NO DATA FOUND</strong></td></tr>
    }
    else
    {
        foreach (var item in Model.InterStoreDetails)
        {
            Cntr = Cntr + 1;
            <tr>
                <td>@Cntr</td>
                <td style="white-space:nowrap;">
                    <a class="table-link link-danger" onclick="DeleteModelRow(this)">
                        <span class="fa-stack">
                           
                            <i class="fa-solid fa-trash fa-stack-1x"></i>
                        </span>
                    </a>
                    <input type="checkbox" class="MBCheckbox mb-checkbox" id="MBCheckbox-@Cntr"  />
                </td>
                <td style="background-color: #e09ef0;"><input type="text" id="PartCode-@Cntr" value="@item.PartCode" readonly></input><input id="ItemCode-@Cntr" type="hidden" value="@item.ItemCode" /></td>
                <td><input type="text" id="ItemName-@Cntr" value="@item.ItemName" readonly></td>

                <td>
                    <input id="Qty-@Cntr"
                           class="qty"
                           type="number"
                           style="width:70px;background-color:lightpink"
                           value="@item.Qty"
                           data-rowno="@Cntr"
                           data-itemcode="@item.ItemCode"
                           onclick="OpenLotAllocationModal(this)" />
                </td>
                <td><input type="number" class="rate" id="Rate-@Cntr" style="width:70px" value="@item.Rate" ></td>
                
               
                <td><input type="number" style="width:70px" id="TotalStock-@Cntr" value="@item.TotalStockQty" readonly></td>
                <td><input type="number" style="width:70px" id="BatchStock-@Cntr" value="@item.LotStockQty" readonly></td>
                <td><input type="text" id="BatchNo-@Cntr" value="@item.BatchNo" readonly></td>
                <td><input type="text" id="uniquebatchno-@Cntr" value="@item.UniqueBatchNo" readonly></td>


                @* <td><input type="text" style="width:70px" value="@item.DiscCategoryName" readonly></td>*@
                <td><input type="text" id="unit-@Cntr" style="width:50px" value="@item.Unit" readonly></td>
               


            </tr>
        }
    }
}