@section Scripts
{
    <script>
        function showLoader() {
            $('#fullPageLoader').fadeIn(100);
        }

        function hideLoader() {
            $('#fullPageLoader').fadeOut(100);
        }

        function CheckNumberOfCols(file) {

            var reader = new FileReader();

            reader.onload = function(e) {
                var data = e.target.result;
                var workbook = XLSX.read(data, { type: 'binary' });
                var sheetName = workbook.SheetNames[0];
                var worksheet = workbook.Sheets[sheetName];
                var rowCount = XLSX.utils.decode_range(worksheet['!ref']).e.r + 1; // Number of rows
                var columnCount = XLSX.utils.decode_range(worksheet['!ref']).e.c + 1; // Number of columns

                // Define the expected number of columns
                var expectedColumnCount = 15; // Change this to your desired number of columns

                if (columnCount === expectedColumnCount) {
                    console.log('The Excel file has the expected number of columns.');
                } else {
                    $.notify('The file does not have the expected number of columns.', "error");
                    return false;
                }
            };

            reader.readAsBinaryString(file);
        }
        function toggleButtons() {
            var type = $('#ddlApplyType').val();

            if (type === 'updateRMQty') {
                $('#btnApplyToAll').prop('disabled', false);
                $('#btnApplyToAllRMItemCode').prop('disabled', true);
            }
            else if (type === 'ChangeRMPartCode') {
                $('#btnApplyToAll').prop('disabled', true);
                $('#btnApplyToAllRMItemCode').prop('disabled', false);
            }
            else {
                // Blank selection - enable both buttons
                $('#btnApplyToAll').prop('disabled', false);
                $('#btnApplyToAllRMItemCode').prop('disabled', false);
            }
        }

        $('#ddlApplyType').change(function() {
            toggleButtons();
        });

        // Initial load

        function GeneratePagination(
            currentPage,
            totalPages,
            searchText = '') {

            let html = '';

            if (currentPage > 1) {

                html += `
                <button  type="button" class="btn btn-sm btn-primary me-1"
                onclick="GetItemData(${currentPage - 1}, '${searchText}')">
                Prev
                </button>`;
            }

            for (let i = 1; i <= totalPages; i++) {

                if (
                    i == 1 ||
                    i == totalPages ||
                    (i >= currentPage - 2 && i <= currentPage + 2)
                ) {

                    html += `
                <button type="button" class="btn btn-sm ${i == currentPage ? 'btn-success' : 'btn-light'} me-1"
                onclick="GetItemData(${i}, '${searchText}')">
                ${i}
                </button>`;
                }
            }

            if (currentPage < totalPages) {

                html += `
                <button  type="button" class="btn btn-sm btn-primary"
                onclick="GetItemData(${currentPage + 1}, '${searchText}')">
                Next
                </button>`;
            }

            $("#PaginationDiv").html(html);
        }
        let searchTimeout;

        $("#search-box1").on("keyup", function() {

            clearTimeout(searchTimeout);

            let searchText = $(this).val();

            if (
                searchText.length > 0 &&
                searchText.length < 2
            ) {
                return;
            }

            searchTimeout = setTimeout(function() {

                GetItemData(1, searchText);

            }, 500);
        });


        let allData = [];

        // LOAD DATA
        function GetItemData(page = 1, searchText = '', isNewFilter = false) {

            var FGPartCode = $('#FGPartCode').val();
            var FGItemName = $('#FGItemName').val();
            var RMPartCode = $('#RMPartCode').val();
            var RMItemName = $('#RMItemName').val();

            if (isNewFilter) {

                allData = [];
            }
            else {

                SaveCurrentPageData();
            }
            showLoader();

            $.ajax({

                type: 'POST',

                url: '@Url.Action("GetItemData")',

                data: {
                    page: page,
                    pageSize: 1000,
                    searchText: searchText,
                    FGPartCode: FGPartCode,
                    FGItemName: FGItemName,
                    RMPartCode: RMPartCode,
                    RMItemName: RMItemName

                },

                success: function(response) {

                    $("#MultiItemBody").empty();

                    $.each(response.data, function(i, item) {

                        // STORE FIRST TIME DATA
                        let exists = allData.find(x => x.FGItemCode == item.fgItemCode && x.RMItemCode == item.rmItemCode && x.BomNo == item.bomNo);

                        if (!exists) {

                            allData.push({

                                FGItemCode: item.fgItemCode ?? 0,
                                RMItemCode: item.rmItemCode ?? 0,
                                BomNo: item.bomNo ?? 0,

                                FGPartCode: item.fgPartCode ?? '',
                                FGItemName: item.fgItemName ?? '',
                                RMPartCode: item.rmPartCode ?? '',
                                RMItemName: item.rmItemName ?? '',

                                RMQty: item.rmQty ?? 0,
                                Scrap: item.scrap ?? 0,
                                GrossWeight: item.grossWeight ?? 0,
                                NetWeight: item.netWeight ?? 0,

                                BurnQty: item.burnQty ?? ''
                            });
                        }

                        let row = `

                <tr>

                            <td> <input type="checkbox"
                           class="form-check-input rowCheckbox"
                           name="rowCheckbox"
                           value="${item.fgItemCode ?? 0}" />

                    <span class="ms-1">${i + 1}</span>
                </td>
                    <td style="min-width:70px">
                        <input type="text"
                        class="form-control form-control-sm" readonly
                               name="BomNo"

                               value="${item.bomNo ?? 0}" />
                    </td>

                    <td >
                        <input type="hidden"
                               name="FGItemCode"
                               value="${item.fgItemCode ?? 0}" />

                        <input type="text"
                               class="form-control form-control-sm"
                               name="FGPartCode" readonly
                               value="${item.fgPartCode ?? ''}" />
                    </td>

                    <td>
                        <input type="text"
                               class="form-control form-control-sm"
                               name="FGItemName" readonly
                               value="${item.fgItemName ?? ''}" />
                    </td>

                    <td>
                        <input type="hidden"
                               name="RMItemCode"
                               value="${item.rmItemCode ?? 0}" />

                        <input type="text"
                               class="form-control form-control-sm"
                               name="RMPartCode" readonly
                               value="${item.rmPartCode ?? ''}" />
                    </td>

                    <td>
                        <input type="text"
                               class="form-control form-control-sm"
                               name="RMItemName" readonly
                               value="${item.rmItemName ?? ''}" />
                    </td>

                    <td style="min-width:100px">
                        <input type="text"
                               class="form-control form-control-sm numberInput"
                               name="RMQty"

                               value="${item.rmQty ?? 0}" />
                    </td>

                    <td style="min-width:100px">
                        <input type="text"
                               class="form-control form-control-sm numberInput"
                               name="Scrap"

                               value="${item.scrap ?? 0}" />
                    </td>

                    <td style="min-width:100px">
                        <input type="text"
                               class="form-control form-control-sm numberInput"
                               name="GrossWeight"

                               value="${item.grossWeight ?? 0}" />
                    </td>

                    <td style="min-width:100px">
                        <input type="text"
                               class="form-control form-control-sm numberInput"
                               name="NetWeight"

                               value="${item.netWeight ?? 0}" />
                    </td>

                    <td>
                        <input type="text"
                               class="form-control form-control-sm numberInput"
                               name="BurnQty"

                               value="${item.burnQty ?? ''}" />
                    </td>

                </tr>
                `;




                        $("#MultiItemBody").append(row);

                    });

                    GeneratePagination(
                        response.page,
                        response.totalPages,
                        searchText
                    );

                    $("#lblTotalNoOfItems1")
                        .text(response.totalRecords);

                    hideLoader();
                },

                error: function(xhr) {

                    console.log(xhr.responseText);

                    hideLoader();
                }
            });
        }

        $(document).on('keydown', '.numberInput', function(e) {

            if (e.key === '-' || e.key === 'Minus') {
                e.preventDefault();
            }
        });

        $(document).on('input', '.numberInput', function() {

            let value = $(this).val();

            // remove invalid chars
            value = value.replace(/[^0-9.]/g, '');

            // allow only one decimal point
            value = value.replace(/(\..*)\./g, '$1');

            $(this).val(value);
        });
        function SaveCurrentPageData() {

            $("#MultiItemBody tr").each(function() {

                let fgItemCode = $(this)
                    .find('[name="FGItemCode"]')
                    .val();

                let rmItemCode = $(this)
                    .find('[name="RMItemCode"]')
                    .val();
                let bomNo = $(this)
                    .find('[name="BomNo"]')
                    .val();

                let existing = allData.find(x =>
                    x.FGItemCode == fgItemCode &&
                    x.BomNo == bomNo &&
                    x.RMItemCode == rmItemCode
                );

                if (existing) {
                    existing.BomNo =
                        $(this).find('[name="BomNo"]').val();


                    existing.FGPartCode =
                        $(this).find('[name="FGPartCode"]').val();

                    existing.FGItemName =
                        $(this).find('[name="FGItemName"]').val();

                    existing.RMPartCode =
                        $(this).find('[name="RMPartCode"]').val();

                    existing.RMItemName =
                        $(this).find('[name="RMItemName"]').val();

                    existing.RMQty =
                        $(this).find('[name="RMQty"]').val();

                    existing.Scrap =
                        $(this).find('[name="Scrap"]').val();

                    existing.GrossWeight =
                        $(this).find('[name="GrossWeight"]').val();

                    existing.NetWeight =
                        $(this).find('[name="NetWeight"]').val();

                    existing.BurnQty =
                        $(this).find('[name="BurnQty"]').val();
                }

            });

        }

        
        function ValidateGridData() {

            let IsErr = false;

            $('#MultiItemBody tr').each(function(index) {

                let row = $(this);

                row.find('input').removeClass('border-danger');

                let fgPartCode =
                    row.find('[name="FGPartCode"]').val();

                let rmPartCode =
                    row.find('[name="RMPartCode"]').val();

                let rowNo = index + 1;

                let rmQty =
                    parseFloat(row.find('[name="RMQty"]').val()) || 0;

                let burnQty =
                    parseFloat(row.find('[name="BurnQty"]').val()) || 0;

                let scrap =
                    parseFloat(row.find('[name="Scrap"]').val()) || 0;

                let gross =
                    parseFloat(row.find('[name="GrossWeight"]').val()) || 0;

                let net =
                    parseFloat(row.find('[name="NetWeight"]').val()) || 0;

                // Burn Qty Validation
                if (burnQty > 0 && burnQty >= rmQty) {

                    row.find('[name="BurnQty"]')
                        .addClass('border-danger');

                    // Focus row
                    row[0].scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });

                    row.find('[name="BurnQty"]').focus();

                    $.notify(

                        `Row ${rowNo} | FG: ${fgPartCode} | RM: ${rmPartCode}
                                 -> Burn Qty should be less than RM Req Qty.`,

                        "error"
                    );

                    IsErr = true;

                    return false;
                }

                // Scrap Validation
                if (scrap > 0 && scrap >= rmQty) {

                    row.find('[name="Scrap"]')
                        .addClass('border-danger');

                    // Focus row
                    row[0].scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });

                    row.find('[name="Scrap"]').focus();

                    $.notify(

                        `Row ${rowNo} | FG: ${fgPartCode} | RM: ${rmPartCode}
                                 -> Scrap should be less than RM Req Qty.`,

                        "error"
                    );

                    IsErr = true;

                    return false;
                }

                if (scrap > 0 && gross > 0 && scrap >= gross) {

                    row.find('[name="GrossWeight"]')
                        .addClass('border-danger');

                    row[0].scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });

                    row.find('[name="GrossWeight"]').focus();

                    $.notify(

                        `Row ${rowNo} | FG: ${fgPartCode} | RM: ${rmPartCode}
                                 -> Scrap should be less than Gross Weight.`,

                        "error"
                    );

                    IsErr = true;

                    return false;
                }

                // Gross > Net Validation
                if (gross > 0 && net > 0 && gross <= net) {

                    row.find('[name="GrossWeight"], [name="NetWeight"]')
                        .addClass('border-danger');

                    row[0].scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });

                    row.find('[name="GrossWeight"]').focus();

                    $.notify(

                        `Row ${rowNo} | FG: ${fgPartCode} | RM: ${rmPartCode}
                                 -> Gross Weight must be greater than Net Weight.`,

                        "error"
                    );

                    IsErr = true;

                    return false;
                }

            });

            return !IsErr;
        }

        
