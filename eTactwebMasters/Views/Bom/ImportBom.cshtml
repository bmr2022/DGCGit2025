        function GetFormRights() {

            $.ajax({
                url: "@Url.Action("GetFormRights")",
                type: "POST",
                data: { formKey: formKey },
                success: function(data) {
                    if (data != null) {

                        var obj = $.parseJSON(data);
                        if (obj.Result.Table.length == 0) {
                            $("#BtnSubmit").prop("disabled", true);
                            $("#FooterBtnSubmit").prop("disabled", true);
                        } else {
                            console.log(obj);
                            var optAll = obj.Result.Table[0].OptAll;
                            var optSave = obj.Result.Table[0].OptSave;
                            var optUpdate = obj.Result.Table[0].OptUpdate;
                            var optDelete = obj.Result.Table[0].OptDelete;
                            var optView = obj.Result.Table[0].OptView;
                            if (!optAll) {
                                if (!optSave) {
                                    $("#BtnSubmit").prop("disabled", true);
                                    $("#FooterBtnSubmit").prop("disabled", true);
                                }
                            }
                        }

                    }
                },
                error: function(errMsg) {
                    $.notify(errMsg, { position: "top center", className: "error" });
                }
            });
        }

        function UploadButton() {
            showLoader();
            var fileInput = $('#ExcelFile');
            var file = fileInput.prop("files")[0];


            if (file) {
                //if(!CheckNumberOfCols(file)) return false;
                var fileName = file.name;

                var fileExtension = fileName.split('.').pop().toLowerCase();

                if (fileExtension === 'xls' || fileExtension === 'xlsx') {
                    // The selected file is in Excel format
                    console.log('File is in Excel format.');
                    var reader = new FileReader();

                    reader.onload = function(e) {

                        var data = e.target.result;
                        var workbook = XLSX.read(data, { type: 'binary' });
                        var sheetName = workbook.SheetNames[0];
                        var worksheet = workbook.Sheets[sheetName];
                        var rowCount = XLSX.utils.decode_range(worksheet['!ref']).e.r + 1; // Number of rows
                        var columnCount = XLSX.utils.decode_range(worksheet['!ref']).e.c + 1; // Number of columns
                        var UpdateRevNo = $('#UpdateRevNo').is(':checked') ? 'Y' : 'N';
                        // Define the expected number of columns
                        var expectedColumnCount = 17; // Change this to your desired number of columns

                        // if (columnCount === expectedColumnCount) {
                        console.log('The Excel file has the expected number of columns.');

                        var formData = new FormData();
                        formData.append("excelFile", file);
                        formData.append("UpdateRevNo", UpdateRevNo);

                        $.ajax({
                            url: "/Bom/UploadExcel",
                            type: "POST",
                            data: formData,
                            async: false,
                            processData: false,
                            contentType: false,
                            success: function(result) {

                                $('#uploadResult').html(result);
                                var RowCount = $('#divItemList tr').length;
                                var errorCount = 0;
                                for (let i = 1; i <= RowCount; i++) {
                                    if ($('#Constraint-' + i).val() == "true") {
                                        $('.' + i).css("color", "red");
                                    }


                                }

                            },
                            complete: function() {
                                // btn.text(oldText).prop("disabled", false);
                                hideLoader();
                            },

                            error: function(response) {
                                alert(response.responseText);
                                hideLoader();
                            }
                        });

                        // } else {

                        //     $.notify('The file does not have the expected number of columns.', "error");
                        //     return false;
                        // }
                    };

                    reader.readAsBinaryString(file);

                } else {
                    // The selected file is not in Excel format
                    $.notify('File is not in Excel format.', "error");
                    hideLoader();
                    return false;
                }
            }
            else {
                // No file selected
                $.notify('No file selected.', 'error');
                hideLoader();
                return false;
            }

             

        }

        function DeleteItemRow(seqNo) {
            //var Indx = parseInt(seqNo) - 1;
            //$('.' + seqNo).remove();

            var $row = $('.' + seqNo);
            if ($row.length) {
                // Delete the row
                $row.remove();

                // Reset IDs in sequence for remaining rows
                var $table = $('#divItemList'); // Replace with your table's ID
                var $rows = $table.find('tr');

                $rows.each(function(index) {
                    var $currentRow = $(this);
                    $currentRow.attr('class', (index + 1)); // Reset row class

                    // Reset IDs for elements inside the row
                    $currentRow.find('[id^="FGPartCode-"]').attr('id', 'FGPartCode-' + (index + 1));
                    $currentRow.find('[id^="FGItemCode-"]').attr('id', 'FGItemCode-' + (index + 1));
                    $currentRow.find('[id^="FGItemName-"]').attr('id', 'FGItemName-' + (index + 1));
                    $currentRow.find('[id^="RMPartCode-"]').attr('id', 'RMPartCode-' + (index + 1));
                    $currentRow.find('[id^="RMItemCode-"]').attr('id', 'RMItemCode-' + (index + 1));
                    $currentRow.find('[id^="RMItemName-"]').attr('id', 'RMItemName-' + (index + 1));
                    $currentRow.find('[id^="BomName-"]').attr('id', 'BomName-' + (index + 1));
                    $currentRow.find('[id^="BomNo-"]').attr('id', 'BomNo-' + (index + 1));
                    $currentRow.find('[id^="RMQty-"]').attr('id', 'RMQty-' + (index + 1));
                    $currentRow.find('[id^="RMUnit-"]').attr('id', 'RMUnit-' + (index + 1));
                    $currentRow.find('[id^="Location-"]').attr('id', 'Location-' + (index + 1));
                    $currentRow.find('[id^="Constraint-"]').attr('id', 'Constraint-' + (index + 1));
                });
            }
        }
