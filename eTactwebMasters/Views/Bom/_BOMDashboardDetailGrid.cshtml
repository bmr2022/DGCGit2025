                                        <a class="table-link link-primary" asp-action="BomForm"
                                        asp-route-FIC="@encryptDecrypt.Encrypt(Convert.ToString(@Model.DTDashboard.Rows[i]["FGPartCode"]))"
                                           asp-route-BMNo="@EncryptDecrypt.EncodeID(Convert.ToInt32(@Model.DTDashboard.Rows[i]["BomNo"]))" asp-route-Mode=@encryptDecrypt.Encrypt("U") onclick="confirmEdit(event)">
                                                    <span class="fa-stack">
                                                        <i class="fa fa-square fa-stack-2x"></i>
                                                        <i class="fa fa-pencil fa-stack-1x fa-inverse"></i>
                                                    </span>
                                                </a>
                                            </div>

                                        </div>
