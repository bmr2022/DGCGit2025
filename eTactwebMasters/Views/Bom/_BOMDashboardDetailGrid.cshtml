                                    <td>@Model.DTDashboard.Rows[i]["FGPartCode"]</td>

                                    <td>@Model.DTDashboard.Rows[i]["FGItem"]</td>
                                <td>@Model.DTDashboard.Rows[i]["RMPartCode"]</td>
                                    <td>@Model.DTDashboard.Rows[i]["RMItemName"]</td>

                                    <td>@Model.DTDashboard.Rows[i]["bomname"]</td>

                                    <td>@Model.DTDashboard.Rows[i]["BomQty"]</td>

                            <td>@Model.DTDashboard.Rows[i]["EntryDate"]?.ToString()?.Split(" ")[0]</td>
                            <td>@Model.DTDashboard.Rows[i]["EffectiveDate"]?.ToString()?.Split(" ")[0]</td>
                                    <td>@Model.DTDashboard.Rows[i]["fgitemcode"]</td>
                                </tr>
                                srNo++;
                            }
                    }
                }
            </tbody>
        </table>
    </div>
@{
    int displayedRows = Model.PageNumber * Model.PageSize;
    if (displayedRows > Model.TotalRecords)
    {
        displayedRows = Model.TotalRecords;
    }
}

<center>
    <strong>
        <span style="margin-right: 30px;">TOTAL ROWS : <span>@displayedRows</span></span>
        <span>TOTAL RECORDS : <span>@Model.TotalRecords</span></span>
    </strong>
</center>
@{
    int totalPages = (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize);
}
@if (Model.TotalRecords > 0)
{
    <ul class="pagination d-flex align-items-center">
        @if (Model.PageNumber > 1)
        {
            <li class="page-item">
                <a class="page-link" href="#" onclick="loadPage(@(Model.PageNumber - 1)); return false;">Previous</a>
            </li>
        }

        @if (Model.PageNumber > 3)
        {
            <li class="page-item">
                <a class="page-link" href="#" onclick="loadPage(1); return false;">1</a>
            </li>
            <li class="page-item disabled"><a class="page-link">...</a></li>
        }

        @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.PageNumber + 2, totalPages); i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="#" onclick="loadPage(@i); return false;">@i</a>
            </li>
        }

        @if (Model.PageNumber < totalPages - 2)
        {
            <li class="page-item disabled"><a class="page-link">...</a></li>
            <li class="page-item">
                <a class="page-link" href="#" onclick="loadPage(@totalPages); return false;">@totalPages</a>
            </li>
        }

        @if (Model.PageNumber < totalPages)
        {
            <li class="page-item">
                <a class="page-link" href="#" onclick="loadPage(@(Model.PageNumber + 1)); return false;">Next</a>
            </li>
        }
    </ul>
}
<style>
    #container {
        display: flex;
    }

        #container > div {
            flex: 1;
            margin-right: 10px; /* Adjust margin as needed */
        }

    #bomTable {
        width: 100%;
        border-collapse: collapse;
    }

    #tableHead th {
        background-color: #127387;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    tbody td {
        /* Table cell styles */
    }

    .sort-icon {
        padding: 5px;
        margin: 5px;
        vertical-align: top;
    }

    .ascCol {
        font-size: 15px;
        vertical-align: bottom;
    }

    .descCol {
        font-size: 15px;
        vertical-align: super;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        list-style: none;
        padding: 0;
        margin: 20px auto;
        gap: 5px; /* Space between buttons */
        white-space: nowrap; /* Keeps it in a single line */
    }

    .page-item {
        display: inline-block;
    }

    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        text-decoration: none;
        color: black;
        border: 1px solid #ddd;
        font-size: 16px;
        background-color: white;
        border-radius: 5px;
        transition: background 0.3s;
    }

    .page-item.active.page-link {
        background-color: #4CAF50;
        color: white;
        border: 1px solid #4CAF50;
    }

    .page-item.disabled.page-link {
        background-color: #f0f0f0;
        color: #999;
        cursor: default;
    }

    .page-link:hover:not(.disabled):not(.active) {
        background-color: #ddd;
    }
</style> *@



