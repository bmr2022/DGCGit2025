				function BomValidation() {
			 let IsErr = "";
				EditEachItem = false;
			 $(".valid").each(function () {
				 $(this).removeClass('is-invalid');
				 IsErr = 0;
			 });

			 // Finish Item Code
			 if (!$('#FinishItemCode').val()) {
				 AddErrorCls('FinishItemCode');
				 $.notify("Finish Item Code is required.", "error");
				 IsErr = 1;
			 }

			 // Finished Item Name
			 if (!$('#FinishedItemName').val()) {
				 AddErrorCls('FinishedItemName');
				 $.notify("Finished Item Name is required.", "error");
				 IsErr = 1;
			 }

			 // Qty check only when ItemName exists
			 if ($('#ItemName').val() != "" && $('#ItemName').val() != null) {
				 // if (!$('#Qty').val() || $('#Qty').val() == "0.00" || $('#Qty').val() == "0") {
					//  AddErrorCls('Qty');
					//  $.notify("Qty cannot be 0.", "error");
					//  IsErr = 1;
				 // }
					 let qty = parseFloat($('#Qty').val());

				if (isNaN(qty) || qty <= 0) {
					AddErrorCls('Qty');
					$.notify("Qty must be greater than 0.", "error");
					IsErr = 1;
