			 var Gross = parseFloat($('#GrossWt').val()) || 0;
			 var net = parseFloat($('#NetWt').val()) || 0;
			 var scrap = 0;

			 if (Gross > 0 && net > 0) {
				 scrap = Gross - net;
				 $('#Scrap').val(scrap.toFixed(6));
				 $('#RunnerQty').val(scrap.toFixed(6));
			 } else {
				 $('#Scrap').val('0.00');
				 $('#RunnerQty').val('0.00');
			 }
		 }
