		function toggleSection() {
			const checkbox = document.getElementById("hideUnhideToggle");
			const section = document.getElementById("B_Measurements");

			if (!checkbox || !section) return;

			// LEFT (OFF / gray) → HIDE
			if (!checkbox.checked) {
				section.classList.add("d-none");
			}
			// RIGHT (ON / blue) → SHOW
			else {
				section.classList.remove("d-none");
			}
		}

