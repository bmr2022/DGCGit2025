@section Scripts
{
	<script>
		function mapItem(val, textField) {
				return {
					id: val.Item_Code,
					text: val[textField],
					partCode: val.PartCode,
					itemName: val.ItemName
				};
			}
		
  var formKey=$('#formKey').val();
             var uniqueKey=$('#uniqueKey').val();
$(document).ready(function () 
{
    formKey=$('#formKey').val();
