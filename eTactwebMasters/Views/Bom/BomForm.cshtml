CalculateMasterBatchTotal();
$('#FinishItemCode').select2({
			   placeholder: '-Select Part Code-',
			   minimumInputLength: 2,
			   allowClear: true,
			   ajax: {
				   url: "@Url.Action("GetFGPartCodeList")",
				   type: "POST",
				   dataType: "json",
				   data: function (params) {
					   return {
						   SearchText: params.term,
						CTRL: $('#PN1').is(':checked') ? 'T' : 'F'
					   };
				   },
				   processResults: function (result) {
					   var obj = $.parseJSON(result);
					   if (obj.StatusCode !== 200) return { results: [] };

					   return {
						   results: $.map(obj.Result, function (v) {
							   return mapItem(v, 'PartCode');
						   })
					   };
				   }
			   },
			   templateSelection: function (item) {
				 //  if (item.element) setData(item.element, item);
				   return item.text;
			   }
		   });

