		function calculateDeltaE() {
			const Ldash = parseFloat(document.querySelector('[name="Ldash"]').value) || 0;
			const Adash = parseFloat(document.querySelector('[name="Adash"]').value) || 0;
			const Bdash = parseFloat(document.querySelector('[name="Bdash"]').value) || 0;

			const L = parseFloat(document.querySelector('[name="LValue"]').value) || 0;
			const A = parseFloat(document.querySelector('[name="AValue"]').value) || 0;
			const B = parseFloat(document.querySelector('[name="BValue"]').value) || 0;

			const Dl = L - Ldash;
			const Da = A - Adash;
			const Db = B - Bdash;

			const sumOfSquares = (Dl * Dl) + (Da * Da) + (Db * Db);
			const deltaE = Math.sqrt(sumOfSquares);

			document.querySelector('[name="DeltaE"]').value = deltaE.toFixed(4);
		}
			
		document.querySelectorAll('[name="Ldash"], [name="Adash"], [name="Bdash"], [name="LValue"], [name="AValue"], [name="BValue"]')
		.forEach(input => {
			input.addEventListener('input', calculateDeltaE);
		});
				
		function CalculateMasterBatchTotal() {

			let totalReqQty = 0;
			let totalAmount = 0;

			// Loop all grid rows
			$("#divBomGrid tr").each(function () {

				let reqQty = parseFloat(
					$(this).find(".tdReqBomQty").text()
				) || 0;

				let rate = parseFloat(
					$(this).find(".tdRate").text()
				) || 0;

				totalReqQty += reqQty;
				totalAmount += (reqQty * rate);

			});

			let materialCost = 0;

			if (totalReqQty > 0) {
				materialCost = totalAmount / totalReqQty;
			}

			$("#lblTotalReqAsBomQty").text(
				totalReqQty.toFixed(4)
			);

			$("#lblTotalAmount").text(
				totalAmount.toFixed(4)
			);

			$("#TotalAmount").val(
				totalAmount.toFixed(4)
			);

			$("#lblMaterialCost").text(
				materialCost.toFixed(4)
			);

			$("#MaterialCost").val(
				materialCost.toFixed(4)
			);
		}
				
		function CalculateAmount() {

			let qty = parseFloat($("#TotalRmQtyForTotBomQty").val()) || 0;

			let rate = parseFloat($("#Rate").val()) || 0;

			let amount = qty * rate;

			$("#Amount").val(
				amount.toFixed(4)
			);
		}
						
		function GetItemRate() {
			$.ajax({
				type: "POST",
				url: "@Url.Action("GetItemRate", "DevlopmentBOM")",
				data: { ItemCode: $('#ItemCode').val(), TillDate: $('#EffectiveDate').val(), YearCode: $('#YearCode').val() },
				dataType: "json",
				async: false,
				success: function (result, status, error) {

					if (result != null) {
						var obj = $.parseJSON(result);
						if (obj.Result[0] == undefined) {
							$('#Rate').prop("readonly", false);
						}
						else {
							$('#Rate').val(obj.Result[0].Rate);

							if (parseInt(obj.Result[0].Rate) == 0) {
								$('#Rate').prop("readonly", false);
							}
						}

					}
				}
			});
		}
